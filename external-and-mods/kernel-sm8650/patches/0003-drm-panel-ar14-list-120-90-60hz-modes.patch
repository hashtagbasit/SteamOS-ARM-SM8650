From: SteamOS-ARM-SM8650 port
Subject: [PATCH] drm/panel: ar14-144hz: also list 120/90/60 Hz modes

The Pocket FIT panel driver exposes only its native 144 Hz mode, so gamescope
has a single-entry refresh table and Steam offers no refresh-rate slider
(only 144/n frame limits). 60 fps content then judders on 144 Hz.

The panel runs in DSI video mode; list 120/90/60 Hz at the same pixel clock
by stretching the vertical front porch (the Steam Deck OLED / ROG Ally
approach). 144 Hz stays the preferred mode.

--- a/drivers/gpu/drm/panel/panel-ar14-144hz.c
+++ b/drivers/gpu/drm/panel/panel-ar14-144hz.c
@@ -365,7 +365,39 @@
 static int panel_ar14_144hz_get_modes(struct drm_panel *panel,
 				      struct drm_connector *connector)
 {
-	return drm_connector_helper_get_modes_fixed(connector, &panel_ar14_144hz_mode);
+	static const int rates[] = { 144, 120, 90, 60 };
+	const struct drm_display_mode *base = &panel_ar14_144hz_mode;
+	int i, count = 0;
+
+	for (i = 0; i < ARRAY_SIZE(rates); i++) {
+		struct drm_display_mode *mode;
+		int vtotal = DIV_ROUND_CLOSEST(base->clock * 1000,
+					       base->htotal * rates[i]);
+		int grow = vtotal - base->vtotal;
+
+		if (grow < 0)
+			continue;
+
+		mode = drm_mode_duplicate(connector->dev, base);
+		if (!mode)
+			break;
+
+		/* same pixel clock, longer vertical front porch */
+		mode->vsync_start += grow;
+		mode->vsync_end += grow;
+		mode->vtotal = vtotal;
+		mode->type = DRM_MODE_TYPE_DRIVER;
+		if (i == 0)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+		drm_mode_set_name(mode);
+		drm_mode_probed_add(connector, mode);
+		count++;
+	}
+
+	connector->display_info.width_mm = base->width_mm;
+	connector->display_info.height_mm = base->height_mm;
+
+	return count;
 }

 static const struct drm_panel_funcs panel_ar14_144hz_panel_funcs = {
